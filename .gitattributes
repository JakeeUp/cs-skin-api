# Normalize line endings: LF in the repo and working tree by default
* text=auto eol=lf

# Windows scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.gif binary
*.ico binary

# Vendored code: hide from diffs and language stats
third_party/** -diff linguist-vendored
