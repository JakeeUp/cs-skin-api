# Copy this file to .env and fill in the values. .env is gitignored.

# SkinsTrack API key - https://skinstrack.com/api-pricing
# The free plan allows 50 calls per month, so the server caches the full
# price list on disk and refreshes it at most every SKINSTRACK_REFRESH_HOURS.
SKINSTRACK_API_KEY=

# Hours between SkinsTrack refreshes. 24 uses ~30 of the 50 monthly calls.
SKINSTRACK_REFRESH_HOURS=24

# Where the cached SkinsTrack snapshot is written.
SKINSTRACK_CACHE_FILE=data/skinstrack-items.json

# Port the C++ API listens on.
PORT=8080

# Browser origin allowed to call the API (CORS). Use the exact origin the
# frontend is served from, e.g. http://127.0.0.1:5500 or your Pages URL.
ALLOWED_ORIGIN=http://127.0.0.1:5500

# Optional CA bundle for HTTPS verification. MSYS2 ships one at
# C:/msys64/ucrt64/etc/ssl/certs/ca-bundle.crt. Leave empty to use libcurl's default.
CURL_CA_BUNDLE=
